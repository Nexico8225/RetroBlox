; Engine configuration file — ColorWorld (made with the RetroBlox SDK)
; Open this folder in Godot 4.5+ and press F5. That's it.

config_version=5

[application]

config/name="ColorWorld"
config/description="Everything is WHITE with a BLACK outline — grab your brush and paint the world! Made with the RetroBlox SDK (retro-blox.vercel.app)."
run/main_scene="res://scenes/colorworld.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[autoload]

CwApi="*res://scripts/cw_api.gd"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
