; RetroBlox Player — classic six-part multiplayer sandbox.
; Open in Godot 4.5.1 or newer. Desktop builds (ENet/UDP), not Web.
config_version=5

[application]
config/name="RetroBlox Player"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.88, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=30.0

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Debris"
3d_physics/layer_3="Players"

[audio]
driver/enable_input=false
