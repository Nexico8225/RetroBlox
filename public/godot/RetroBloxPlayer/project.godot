; RetroBlox Player — the completely new classic player system.
; Sign in (or sign up, or play as a guest), load your account avatar,
; explore built-in places, and chat with everyone online — across the
; internet, through the RetroBlox platform API.
; Open in Godot 4.5.1 or newer. Desktop build (GL Compatibility).
config_version=5

[application]

config/name="RetroBlox Player"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

Api="*res://scripts/core/api.gd"
Session="*res://scripts/core/session.gd"
Settings="*res://scripts/core/settings.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

