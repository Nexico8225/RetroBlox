; RetroBlox Player — classic six-part multiplayer sandbox.
; Open in Godot 4.5.1 or newer. Desktop builds (ENet/UDP), not Web.
config_version=5

[autoload]

Sfx="*res://scripts/sfx.gd"

[application]
config/name="RetroBlox Player"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

