; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RetroBlox Player"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

Api="*res://scripts/core/api.gd"
Session="*res://scripts/core/session.gd"
Settings="*res://scripts/core/settings.gd"
Sfx="*res://scripts/core/sfx.gd"
Pfp="*res://scripts/ui/pfp_service.gd"
UiConfig="*res://scripts/core/ui_config.gd"
UiEditor="*res://scripts/ui/ui_editor.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; v10.0: the window opens COMPACT (960x600) like the old client did — never
; the whole screen. The UI stretches with it (canvas_items), so nothing moves.
window/size/window_width_override=960
window/size/window_height_override=600
window/stretch/mode="canvas_items"

