; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; RetroBlox Player — Godot 4.3+
; The official player system: R6 character, classic movement, chat,
; and your RetroBlox account avatar pulled from the platform API.

config_version=5

[application]

config/name="RetroBlox Player"
config/description="1:1 classic player: R6IK character, old_walk/old_jump/old_idle animations, chat, and your RetroBlox account avatar straight from the platform API."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=2
